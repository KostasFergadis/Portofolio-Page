---
import { profile } from "../data/content";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kostas Fergadis — Software Engineer</title>
    <meta
      name="description"
      content="Kostas Fergadis is a full-stack software engineer in Athens building production web applications with PHP and JavaScript."
    />
    <meta property="og:title" content="Kostas Fergadis — Software Engineer" />
    <meta
      property="og:description"
      content="Full-stack developer working with PHP, JavaScript and MySQL."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@400;700&family=Schibsted+Grotesk:wght@400..800&display=swap"
    />

    <!-- Apply the saved (or OS) theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {
          // Storage can be unavailable (private mode); fall back to the OS theme.
        }
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <Hero />
      <About />
      <Experience />
      <Skills />
      <Projects />
      <Contact />
    </main>
    <footer class="footer container">
      © <span data-year>{new Date().getFullYear()}</span> {profile.name}
    </footer>

    <script>
      // The year is rendered at build time; refresh it so it never goes stale.
      document.querySelector("[data-year]").textContent = new Date().getFullYear();
    </script>
  </body>
</html>
