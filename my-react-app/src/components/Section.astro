---
import "./Section.css";

const { id, title, lead, intro } = Astro.props;
---

<section id={id} class="section container" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="section__title section__header">
    {title}
  </h2>
  <div>
    {lead && <p class="section__lead">{lead}</p>}
    {intro && <p class="section__intro">{intro}</p>}
    <slot />
  </div>
</section>
